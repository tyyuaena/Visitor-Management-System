# ============================================================================
# BACKEND (Laravel) environment variables.
#
# This file documents every variable the application actually reads. Copy
# it to .env for local development — .env is git-ignored and must never be
# committed. In production (AWS Elastic Beanstalk), these are NOT read from
# a file at all: set them as EB "Environment properties"
# (Configuration > Software > Edit) instead.
#
# None of these values are exposed to the React frontend. The frontend has
# its own, separate .env.example (frontend/.env.example) containing only
# VITE_API_URL — a public API base URL, safe to ship in a browser bundle.
# Nothing in this file should ever be prefixed with VITE_ or referenced
# from frontend code.
# ============================================================================

APP_NAME=Laravel

# Before deploying: set APP_ENV=production and APP_DEBUG=false.
# With APP_DEBUG=true, error responses include full stack traces and file
# paths — safe for local development only, never for production.
APP_ENV=local
APP_DEBUG=true

# Generate once with `php artisan key:generate --show` and set as a fixed
# EB environment property. Do NOT regenerate this on every deploy — it
# would invalidate every existing Sanctum token and any encrypted data.
APP_KEY=

# The backend's own public URL (used for generating absolute links and by
# config/filesystems.php's "public" disk URL). In production this is the
# Elastic Beanstalk environment URL (or custom domain), e.g.
# https://your-env.elasticbeanstalk.com — set as an EB environment
# property, never hardcoded here.
APP_URL=http://localhost:8000

# The React frontend's origin. Controls CORS (see config/cors.php) — only
# this exact origin is allowed to make cross-origin API requests. In
# production this is wherever the built frontend is actually hosted
# (e.g. a CloudFront/S3 URL or custom domain), set as an EB environment
# property.
FRONTEND_URL=http://localhost:5173

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# LOG_CHANNEL=stack + LOG_STACK=single writes to storage/logs/laravel.log —
# fine for local dev. On EB, each instance's local disk is not a reliable
# place to read logs from after a deploy/scale event, so set
# LOG_CHANNEL=stderr in the EB environment properties instead — EB's PHP
# platform captures stderr and makes it available via `eb logs` /
# CloudWatch Logs without any extra code change (this app already reads
# LOG_CHANNEL from the environment).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Database — AWS RDS (MySQL) in production
# ----------------------------------------------------------------------------
# Local dev may use sqlite for convenience; production must use mysql
# pointed at the RDS endpoint. All five values below are supplied as EB
# environment properties in production — never commit real credentials.
DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ----------------------------------------------------------------------------
# Session / Cache / Queue
# ----------------------------------------------------------------------------
# All three are database-backed (not "file" or "array") specifically so
# they work correctly behind Elastic Beanstalk's load balancer across
# multiple/rotating instances — a file-based session or cache would be
# instance-local and break as soon as there's more than one instance, or
# an instance is replaced.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# ----------------------------------------------------------------------------
# Sanctum
# ----------------------------------------------------------------------------
# Authentication is bearer-token based (Authorization: Bearer <token>),
# not Sanctum's cookie-based first-party SPA flow — the frontend and
# backend are not required to share a parent domain. SANCTUM_STATEFUL_DOMAINS
# has no effect on this app's actual auth behavior and does not need to be
# set for production; it's left at its framework default.

# ----------------------------------------------------------------------------
# Mail — used for account activation / password reset emails
# ----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
